+// ---- RBT-129 crash diagnosis instrumentation (not upstream) ----
+// RBT_HZN_STATS=<file>: at exit, append the histogram of EPA horizon sizes (edges per EPA iteration).
+// RBT_HZN_GUARD=1: a horizon with more than RBT_HZN_MAX edges ends EPA at the current face instead of
+// overflowing the 24-entry horizon arrays (the stock code writes past them).  Off, the stock behaviour is kept.
+#define RBT_HZN_MAX 24
+static long rbt_hist[65], rbt_iters, rbt_overflow;
+static int rbt_guard = -1;
+static int rbtGuard(void) {
+  if (rbt_guard < 0) { const char* e = getenv("RBT_HZN_GUARD"); rbt_guard = e && e[0] == '1'; }
+  return rbt_guard;
+}
+__attribute__((destructor)) static void rbtStats(void) {
+  const char* p = getenv("RBT_HZN_STATS");
+  if (!p) return;
+  FILE* f = fopen(p, "a");
+  if (!f) return;
+  fprintf(f, "epa_iterations %ld overflow %ld hist", rbt_iters, rbt_overflow);
+  for (int i = 0; i < 65; i++) if (rbt_hist[i]) fprintf(f, " %d:%ld", i, rbt_hist[i]);
+  fprintf(f, "\n");
+  fclose(f);
+}
+// ---- end instrumentation ----
 
