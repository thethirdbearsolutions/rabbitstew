+// ---- RBT-129 EPA-horizon overflow LOG (not upstream; instrumentation only, no behaviour change) ----
+// The stock code below is unchanged: a horizon with more than RBT_HZN_MAX edges still overflows exactly as in stock
+// 3.14.0 (google-deepmind/mujoco#3646).  This only observes it:
+//  - every EPA iteration whose horizon exceeds RBT_HZN_MAX prints one line to stderr ("RBT_HZN overflow: ..."),
+//    flushed BEFORE the stock code goes on to use the overflowed arrays (so a crash still leaves its line);
+//  - RBT_HZN_STATS=<file>: at normal process exit, append the histogram of horizon sizes (edges per EPA iteration).
+#define RBT_HZN_MAX 24
+static long rbt_hist[65], rbt_iters, rbt_overflow;
+__attribute__((destructor)) static void rbtStats(void) {
+  const char* p = getenv("RBT_HZN_STATS");
+  if (!p) return;
+  FILE* f = fopen(p, "a");
+  if (!f) return;
+  fprintf(f, "epa_iterations %ld overflow %ld hist", rbt_iters, rbt_overflow);
+  for (int i = 0; i < 65; i++) if (rbt_hist[i]) fprintf(f, " %d:%ld", i, rbt_hist[i]);
+  fprintf(f, "\n");
+  fclose(f);
+}
+// ---- end RBT-129 log ----
 
